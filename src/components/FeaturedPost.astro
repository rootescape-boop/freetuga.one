---
import type { Post } from '../lib/posts';
import { postHref, postMinutes } from '../lib/posts';
import { fullDate } from '../lib/format';
import Icon from './Icon.astro';

interface Props {
  post: Post;
  label?: string;
}

const { post, label = 'Избранное' } = Astro.props;
const { title, description, cover, coverAlt, tags, date } = post.data;
const href = postHref(post);
const minutes = postMinutes(post);
---

<article class="post-card group relative overflow-hidden rounded-[1.6rem] border border-line bg-surface">
  <a href={href} class="grid gap-0 md:grid-cols-[1.08fr_1fr]">
    <div class="post-card__media post-card__media--flush">
      {cover ? (
        <img src={cover} alt={coverAlt ?? ''} width="1000" height="700" loading="eager" decoding="async" />
      ) : (
        <div class="cover-fallback">
          <span aria-hidden="true">{title.slice(0, 1)}</span>
        </div>
      )}
    </div>

    <div class="flex flex-col justify-center p-6 sm:p-9">
      <p class="eyebrow">{label}</p>

      <h2 class="post-card__title mt-4 font-serif text-[1.8rem] font-medium leading-[1.12] tracking-[-0.02em] sm:text-[2.2rem]">
        {title}
      </h2>

      <p class="mt-3 line-clamp-3 text-[0.95rem] leading-relaxed text-muted">{description}</p>

      <div class="mt-5 flex flex-wrap items-center gap-2 text-[0.78rem] text-muted">
        <time datetime={date.toISOString()}>{fullDate(date)}</time>
        <span aria-hidden="true">·</span>
        <span>{minutes} мин чтения</span>
      </div>

      {tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-1.5">
          {tags.slice(0, 4).map((tag) => <span class="tag">{tag}</span>)}
        </div>
      )}

      <span class="mt-6 inline-flex items-center gap-2 text-sm font-medium">
        Читать материал
        <span class="post-card__arrow"><Icon name="arrow-up-right" size={16} /></span>
      </span>
    </div>
  </a>
</article>

<style>
  .cover-fallback {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    min-height: 240px;
    background:
      radial-gradient(120% 120% at 15% 10%, color-mix(in srgb, var(--c-accent) 38%, transparent), transparent 60%),
      radial-gradient(90% 90% at 85% 90%, color-mix(in srgb, #35505c 40%, transparent), transparent 55%),
      var(--c-chip);
  }

  .cover-fallback span {
    font-family: var(--font-serif);
    font-size: 5rem;
    line-height: 1;
    color: color-mix(in srgb, var(--c-ink) 30%, transparent);
  }
</style>
