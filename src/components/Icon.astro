---
interface Props {
  name:
    | 'search'
    | 'menu'
    | 'close'
    | 'sun'
    | 'moon'
    | 'arrow-up-right'
    | 'arrow-right'
    | 'arrow-left'
    | 'play'
    | 'telegram'
    | 'link'
    | 'chevron-up';
  size?: number;
  class?: string;
}

const { name, size = 18, class: className = '' } = Astro.props;

const icons: Record<Props['name'], string> = {
  search: '<circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>',
  moon: '<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/>',
  'arrow-up-right': '<path d="M7 17 17 7M8 7h9v9"/>',
  'arrow-right': '<path d="M4 12h16M13 5l7 7-7 7"/>',
  'arrow-left': '<path d="M20 12H4M11 5l-7 7 7 7"/>',
  play: '<path d="M8 5.5v13l11-6.5-11-6.5Z" fill="currentColor" stroke="none"/>',
  telegram:
    '<path d="M21.5 4.3 2.9 11.4c-1.2.5-1.2 1.2-.2 1.5l4.8 1.5 1.8 5.5c.2.6.4.7 1 .3l2.6-1.9 4.7 3.5c.9.5 1.5.2 1.7-.8l3-14c.3-1.2-.4-1.8-1.3-1.4Z"/><path d="m8.5 14.2 9.4-5.9"/>',
  link: '<path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/>',
  'chevron-up': '<path d="m6 15 6-6 6 6"/>',
};
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  focusable="false"
  set:html={icons[name]}
/>
