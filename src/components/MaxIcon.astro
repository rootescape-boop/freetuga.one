---
interface Props {
  size?: number;
  class?: string;
}

const { size = 18, class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <rect x="3.4" y="3.4" width="17.2" height="17.2" rx="4.6" />
  <path d="M7.5 16V8l4.5 4L16.5 8v8" />
</svg>
