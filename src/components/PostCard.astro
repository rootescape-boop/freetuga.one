---
import type { Post } from '../lib/posts';
import { postHref, postMinutes, postSection } from '../lib/posts';
import { fullDate } from '../lib/format';
import Icon from './Icon.astro';

interface Props {
  post: Post;
  eager?: boolean;
  showDescription?: boolean;
  showSection?: boolean;
}

const { post, eager = false, showDescription = true, showSection = false } = Astro.props;
const { title, description, cover, coverAlt, tags, date, videos } = post.data;
const href = postHref(post);
const minutes = postMinutes(post);
const section = postSection(post);
---

<article class="post-card group relative" data-entry>
  <a
    href={href}
    class="block rounded-[1.2rem] outline-none"
  >
    <div class="post-card__media">
      {cover ? (
        <img
          src={cover}
          alt={coverAlt ?? ''}
          width="800"
          height="500"
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
        />
      ) : (
        <div class="cover-fallback">
          <span aria-hidden="true">{title.slice(0, 1)}</span>
        </div>
      )}
    </div>

    {videos.length > 0 && (
      <span class="post-card__video" aria-label={`Видео: ${videos.length}`}>
        <Icon name="play" size={11} />
        {videos.length}
      </span>
    )}

    <div class="mt-4 flex items-center gap-2 text-[0.78rem] text-muted">
      {showSection && (
        <>
          <span class="post-card__section">{section.label}</span>
          <span aria-hidden="true">·</span>
        </>
      )}
      <time datetime={date.toISOString()}>{fullDate(date)}</time>
      <span aria-hidden="true">·</span>
      <span>{minutes} мин чтения</span>
    </div>

    <h3 class="post-card__title mt-1.5 font-serif text-[1.3rem] font-medium leading-[1.26] tracking-[-0.01em]">
      {title}
    </h3>

    {showDescription && (
      <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-muted">{description}</p>
    )}

    {tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1.5">
        {tags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}
      </div>
    )}
  </a>
</article>

<style>
  .post-card__video {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.55rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--c-ink) 78%, transparent);
    color: var(--c-paper);
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1;
    backdrop-filter: blur(6px);
  }

  .post-card__section {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.66rem;
    font-weight: 600;
    color: var(--c-accent);
  }

  .cover-fallback {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background:
      radial-gradient(120% 120% at 15% 10%, color-mix(in srgb, var(--c-accent) 38%, transparent), transparent 60%),
      radial-gradient(90% 90% at 85% 90%, color-mix(in srgb, #35505c 40%, transparent), transparent 55%),
      var(--c-chip);
  }

  .cover-fallback span {
    font-family: var(--font-serif);
    font-size: 4.5rem;
    line-height: 1;
    color: color-mix(in srgb, var(--c-ink) 30%, transparent);
  }
</style>
