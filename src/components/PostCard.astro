---
import type { Post } from '../lib/posts';
import { postHref, postMinutes } from '../lib/posts';
import { fullDate } from '../lib/format';

interface Props {
  post: Post;
  eager?: boolean;
  showDescription?: boolean;
}

const { post, eager = false, showDescription = true } = Astro.props;
const { title, description, cover, coverAlt, tags, date } = post.data;
const href = postHref(post);
const minutes = postMinutes(post);
---

<article class="post-card group relative">
  <a
    href={href}
    class="block rounded-[1.2rem] outline-none"
  >
    <div class="post-card__media">
      {cover ? (
        <img
          src={cover}
          alt={coverAlt ?? ''}
          width="800"
          height="500"
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
        />
      ) : (
        <div class="cover-fallback">
          <span aria-hidden="true">{title.slice(0, 1)}</span>
        </div>
      )}
    </div>

    <div class="mt-4 flex items-center gap-2 text-[0.78rem] text-muted">
      <time datetime={date.toISOString()}>{fullDate(date)}</time>
      <span aria-hidden="true">·</span>
      <span>{minutes} мин чтения</span>
    </div>

    <h3 class="post-card__title mt-1.5 font-serif text-[1.3rem] font-medium leading-[1.26] tracking-[-0.01em]">
      {title}
    </h3>

    {showDescription && (
      <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-muted">{description}</p>
    )}

    {tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1.5">
        {tags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}
      </div>
    )}
  </a>
</article>

<style>
  .cover-fallback {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background:
      radial-gradient(120% 120% at 15% 10%, color-mix(in srgb, var(--c-accent) 38%, transparent), transparent 60%),
      radial-gradient(90% 90% at 85% 90%, color-mix(in srgb, #35505c 40%, transparent), transparent 55%),
      var(--c-chip);
  }

  .cover-fallback span {
    font-family: var(--font-serif);
    font-size: 4.5rem;
    line-height: 1;
    color: color-mix(in srgb, var(--c-ink) 30%, transparent);
  }
</style>
