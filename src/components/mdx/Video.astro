---
import VideoEmbed from '../VideoEmbed.astro';
import type { VideoPlatform } from '../../lib/videos';

interface Props {
  platform: VideoPlatform;
  id: string;
  title?: string;
  poster?: string;
  class?: string;
}

const { platform, id, title, poster, class: className } = Astro.props;
---

<VideoEmbed platform={platform} id={id} title={title} poster={poster} class={className} />
