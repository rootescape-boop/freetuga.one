---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Страница не найдена" description="Такой страницы нет — возможно, ссылка устарела." noindex>
  <section class="container-page flex min-h-[60vh] flex-col items-start justify-center py-20">
    <p class="eyebrow">Ошибка 404</p>
    <h1 class="display mt-4 text-[clamp(4rem,16vw,10rem)] leading-none">404</h1>
    <p class="mt-4 max-w-md text-[1.05rem] leading-relaxed text-muted">
      Страница потерялась или никогда не существовала. Зато у блога есть главная и архив — оттуда
      точно что-нибудь найдётся.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="btn btn-primary" href="/">
        На главную
        <Icon name="arrow-right" size={16} />
      </a>
      <a class="btn btn-ghost" href="/archive">Архив статей</a>
    </div>
  </section>
</BaseLayout>
