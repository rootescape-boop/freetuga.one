---
import EntryView from '../../components/EntryView.astro';
import { getSectionPosts, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getSectionPosts('faq');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<EntryView post={post} />
