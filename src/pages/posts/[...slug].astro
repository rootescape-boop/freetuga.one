---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import YouTube from '../../components/mdx/YouTube.astro';
import Rutube from '../../components/mdx/Rutube.astro';
import Video from '../../components/mdx/Video.astro';
import Icon from '../../components/Icon.astro';
import { getPosts, postMinutes, tagSlug, type Post } from '../../lib/posts';
import { fullDate } from '../../lib/format';
import { site } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, cover, coverAlt, tags, videos, author } = post.data;
const minutes = postMinutes(post);

const posts = await getPosts();
const index = posts.findIndex((item) => item.id === post.id);
const newer = index > 0 ? posts[index - 1] : undefined;
const older = index >= 0 && index < posts.length - 1 ? posts[index + 1] : undefined;

const components = { YouTube, Rutube, Video };
---

<BaseLayout
  title={title}
  description={description}
  image={cover}
  type="article"
  publishedTime={date}
>
  <div id="progress" class="fixed inset-x-0 top-0 z-[60] h-[2px] origin-left scale-x-0 bg-accent"></div>

  <article class="pb-16">
    <header class="container-narrow pt-12 sm:pt-16">
      <a
        class="inline-flex items-center gap-1.5 text-xs text-muted transition-colors hover:text-ink"
        href="/posts"
      >
        <Icon name="arrow-left" size={14} />
        Все статьи
      </a>

      {tags.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <a class="tag" href={`/tags/${tagSlug(tag)}`}>{tag}</a>
          ))}
        </div>
      )}

      <h1 class="display mt-4 text-[clamp(2.1rem,4.8vw,3.5rem)]">{title}</h1>

      <p class="mt-4 max-w-2xl text-[1.05rem] leading-relaxed text-muted">{description}</p>

      <div class="mt-7 flex flex-wrap items-center gap-x-3 gap-y-2 border-t border-line pt-5 text-xs text-muted">
        <span class="grid h-8 w-8 place-items-center rounded-full bg-chip font-serif text-sm text-ink" aria-hidden="true">
          {author.slice(0, 1)}
        </span>
        <span class="text-ink">{author}</span>
        <span aria-hidden="true">·</span>
        <time datetime={date.toISOString()}>{fullDate(date)}</time>
        <span aria-hidden="true">·</span>
        <span>{minutes} мин чтения</span>
        {updated && (
          <>
            <span aria-hidden="true">·</span>
            <span>Обновлено {fullDate(updated)}</span>
          </>
        )}

        <button
          id="copy-link"
          type="button"
          class="ml-auto inline-flex items-center gap-1.5 rounded-full border border-line px-3 py-1.5 text-[0.72rem] transition-colors hover:border-ink hover:text-ink"
        >
          <Icon name="link" size={13} />
          <span>Скопировать ссылку</span>
        </button>
      </div>
    </header>

    {cover && (
      <div class="container-page mt-10">
        <img
          src={cover}
          alt={coverAlt ?? ''}
          width="1600"
          height="1000"
          class="aspect-[16/10] w-full rounded-[1.4rem] border border-line object-cover"
          loading="eager"
          decoding="async"
        />
      </div>
    )}

    {videos.length > 0 && (
      <div class="container-narrow mt-10">
        <div class="grid gap-5 sm:grid-cols-2">
          {videos.map((video) => (
            <VideoEmbed
              platform={video.platform}
              id={video.id}
              title={video.title ?? title}
            />
          ))}
        </div>
        <p class="mt-3 text-xs text-muted">Плеер загружается только после нажатия на кнопку.</p>
      </div>
    )}

    <div class="container-narrow mt-10">
      <div class="prose">
        <Content components={components} />
      </div>
    </div>

    <footer class="container-narrow mt-12">
      <div class="flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6">
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <a class="tag" href={`/tags/${tagSlug(tag)}`}>{tag}</a>
          ))}
        </div>
        <a
          class="text-xs text-muted transition-colors hover:text-ink"
          href={`mailto:${site.email}?subject=${encodeURIComponent(`Отклик на статью «${title}»`)}`}
        >
          Написать автору
        </a>
      </div>
    </footer>
  </article>

  {(newer || older) && (
    <nav class="container-page border-t border-line py-10" aria-label="Другие статьи">
      <div class="grid gap-4 sm:grid-cols-2">
        {newer ? (
          <a
            class="group rounded-2xl border border-line p-5 transition-colors hover:border-ink/40"
            href={`/posts/${newer.id}`}
          >
            <span class="flex items-center gap-1.5 text-[0.7rem] uppercase tracking-wide text-muted">
              <Icon name="arrow-left" size={12} /> Новее
            </span>
            <span class="mt-2 block font-serif text-lg leading-snug transition-colors group-hover:text-accent">
              {newer.data.title}
            </span>
          </a>
        ) : (
          <span></span>
        )}

        {older && (
          <a
            class="group rounded-2xl border border-line p-5 text-right transition-colors hover:border-ink/40"
            href={`/posts/${older.id}`}
          >
            <span class="flex items-center justify-end gap-1.5 text-[0.7rem] uppercase tracking-wide text-muted">
              Раньше <Icon name="arrow-right" size={12} />
            </span>
            <span class="mt-2 block font-serif text-lg leading-snug transition-colors group-hover:text-accent">
              {older.data.title}
            </span>
          </a>
        )}
      </div>
    </nav>
  )}
</BaseLayout>

<script>
  const progress = document.getElementById('progress');
  if (progress) {
    const update = () => {
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = scrollable > 0 ? Math.min(1, window.scrollY / scrollable) : 0;
      progress.style.transform = `scaleX(${ratio})`;
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  }

  const copyButton = document.getElementById('copy-link');
  if (copyButton) {
    copyButton.addEventListener('click', async () => {
      const label = copyButton.querySelector('span');
      try {
        await navigator.clipboard.writeText(location.href);
        if (label) {
          const previous = label.textContent;
          label.textContent = 'Ссылка скопирована';
          window.setTimeout(() => {
            label.textContent = previous;
          }, 2000);
        }
      } catch {
        if (label) label.textContent = 'Не удалось скопировать';
      }
    });
  }
</script>
