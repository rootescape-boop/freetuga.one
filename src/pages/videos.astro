---
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import Icon from '../components/Icon.astro';
import { getPosts, postHref } from '../lib/posts';
import { dayMonth, plural } from '../lib/format';
import { platformLabel } from '../lib/videos';

const posts = (await getPosts()).filter((post) => post.data.videos.length > 0);
const total = posts.reduce((sum, post) => sum + post.data.videos.length, 0);
---

<BaseLayout title="Видео" description="Видеоматериалы базы знаний FreeTUGA001: YouTube, Rutube и VK Видео, встроенные без лишних запросов.">
  <section class="container-page pt-14 sm:pt-20">
    <p class="eyebrow">Видео</p>
    <div class="mt-3 flex flex-wrap items-end justify-between gap-5 border-b border-line pb-6">
      <h1 class="display text-[clamp(2.4rem,5vw,3.6rem)]">Видеоматериалы</h1>
      <p class="text-sm text-muted">
        {total} {plural(total, 'ролик', 'ролика', 'роликов')} в {posts.length}
        {plural(posts.length, 'материале', 'материалах', 'материалах')}
      </p>
    </div>
    <p class="mt-5 max-w-xl text-[1.02rem] leading-relaxed text-muted">
      Плеер загружается только после нажатия на кнопку — страница остаётся быстрой, а видео не
      узнаёт о визите заранее.
    </p>
  </section>

  <section class="container-page py-10">
    <div class="grid gap-x-8 gap-y-12 lg:grid-cols-2">
      {posts.map((post) => (
        <article>
          <a class="block font-serif text-2xl leading-snug transition-colors hover:text-accent" href={postHref(post)}>
            {post.data.title}
          </a>

          <div class="mt-2 flex items-center gap-2 text-[0.72rem] uppercase tracking-wide text-muted">
            <time datetime={post.data.date.toISOString()}>{dayMonth(post.data.date)}</time>
            <span aria-hidden="true">·</span>
            <span>
              {post.data.videos.length} {plural(post.data.videos.length, 'видео', 'видео', 'видео')}
            </span>
            <span aria-hidden="true">·</span>
            <span>
              {[...new Set(post.data.videos.map((video) => platformLabel(video.platform)))].join(' · ')}
            </span>
          </div>

          <div class="mt-4 grid gap-4">
            {post.data.videos.map((video) => (
              <VideoEmbed
                platform={video.platform}
                id={video.id}
                title={video.title ?? post.data.title}
                poster={video.poster}
                link={postHref(post)}
              />
            ))}
          </div>

          <a
            class="group mt-4 inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-ink"
            href={postHref(post)}
          >
            Открыть материал
            <Icon name="arrow-right" size={14} class="transition-transform group-hover:translate-x-0.5" />
          </a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
